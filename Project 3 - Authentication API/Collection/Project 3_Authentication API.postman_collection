      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData=pm.response.json();\r",
              "pm.test(\"Status code is 200\", ()=>\r",
              "{\r",
              "    pm.expect(pm.response.code).to.eql(200);\r",
              "}\r",
              ")\r",
              "\r",
              "pm.test(\"response time validation\",()=>\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(4000);\r",
              "})\r",
              "\r",
              "pm.test(\"structure validation\",()=>\r",
              "{\r",
              "    pm.expect(responseData).to.have.property('page');\r",
              "    pm.expect(responseData).to.have.property('per_page');\r",
              "    pm.expect(responseData).to.have.property('total');\r",
              "    pm.expect(responseData).to.have.property('total_pages');\r",
              "    pm.expect(responseData).to.have.property('data');\r",
              "   \r",
              "})\r",
              "\r",
              "pm.test(\"Data type validation\",()=>\r",
              "{\r",
              "   \r",
              "    pm.expect(responseData.page).to.be.a('number')\r",
              "      pm.expect(responseData.per_page).to.be.a('number')\r",
              "       pm.expect(responseData.total).to.be.a('number')\r",
              "        pm.expect(responseData.total_pages).to.be.a('number')\r",
              "        pm.expect(responseData.data).to.be.an('array')\r",
              "        responseData.data.forEach(userDetail =>{\r",
              "        pm.expect(userDetail.id).to.be.a('number')\r",
              "        pm.expect(userDetail.email).to.be.a('string')\r",
              "        pm.expect(userDetail.first_name).to.be.a('string')\r",
              "        pm.expect(userDetail.last_name).to.be.a('string')\r",
              "        pm.expect(userDetail.avatar).to.be.a('string')\r",
              "        })\r",
              "})\r",
              "\r",
              "pm.test(\"Business validation\",()=>{\r",
              "    pm.expect(responseData.page).to.exist\r",
              "    pm.expect(responseData.page).to.eql(1)\r",
              "     pm.expect(responseData.per_page).to.exist\r",
              "    pm.expect(responseData.per_page).to.eql(6)\r",
              "     pm.expect(responseData.total).to.exist\r",
              "    pm.expect(responseData.total).to.eql(12)\r",
              "     pm.expect(responseData.total_pages).to.exist\r",
              "    pm.expect(responseData.total_pages).to.eql(2)\r",
              "    pm.expect(responseData.data).to.exist\r",
              "    pm.expect(responseData.data).to.not.be.empty\r",
              "    pm.expect(responseData.data.length).to.be.eql(responseData.per_page)\r",
              "    responseData.data.forEach(userDetail =>{\r",
              "        pm.expect(userDetail.id).to.exist\r",
              "        pm.expect(userDetail.first_name).to.exist\r",
              "        pm.expect(userDetail.last_name).to.exist\r",
              "        pm.expect(userDetail.id).to.be.above(0)\r",
              "        pm.expect(userDetail.email).to.match(/^[^\\s@]+@[^\\s@]+\\.[^\\s@]+$/)\r",
              "        pm.expect(userDetail.first_name).to.not.be.empty\r",
              "        pm.expect(userDetail.last_name).to.not.be.empty\r",
              "        pm.expect(userDetail.avatar).to.match(/https?:\\/\\/.*\\.jpg$/)\r",
              "    })\r",
