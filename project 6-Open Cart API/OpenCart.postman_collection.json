    {
      "name": "Cart content",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData=pm.response.json()\r",
              "pm.test(\"Status code validation\",()=>\r",
              "{\r",
              "    pm.expect(pm.response.code).to.eql(200)\r",
              "})\r",
              "pm.test(\"Response time validation\",()=>\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(4000)\r",
              "})\r",
              "pm.test(\"Structure validation\",()=>\r",
              "{\r",
              "    pm.expect(responseData).to.have.property(\"products\")\r",
              "    pm.expect(responseData).to.have.property(\"vouchers\")\r",
              "    pm.expect(responseData).to.have.property(\"totals\")\r",
              "    responseData.products.forEach(product =>{\r",
              "    pm.expect(product).to.have.property(\"cart_id\")\r",
              "    pm.expect(product).to.have.property(\"product_id\")\r",
              "    pm.expect(product).to.have.property(\"name\")\r",
              "    pm.expect(product).to.have.property(\"model\")\r",
              "    pm.expect(product).to.have.property(\"option\")\r",
              "    pm.expect(product).to.have.property(\"quantity\")\r",
              "    pm.expect(product).to.have.property(\"stock\")\r",
              "    pm.expect(product).to.have.property(\"shipping\")\r",
              "    pm.expect(product).to.have.property(\"price\")\r",
              "    pm.expect(product).to.have.property(\"total\")\r",
              "    pm.expect(product).to.have.property(\"reward\")\r",
              "    })\r",
              "\r",
              "    responseData.totals.forEach(total =>\r",
              "    {\r",
              "    pm.expect(total).to.have.property(\"title\")\r",
              "    pm.expect(total).to.have.property(\"text\")\r",
              "    })\r",
              "   \r",
              "})\r",
              "pm.test(\"Data type validation\",()=>\r",
              "{\r",
              "pm.expect(responseData.products).to.be.an(\"array\")\r",
              "pm.expect(responseData.vouchers).to.be.an(\"array\")\r",
              "pm.expect(responseData.totals).to.be.an(\"array\")\r",
              "responseData.products.forEach(product =>{\r",
              "    pm.expect(product.cart_id).to.be.a(\"string\")\r",
              "    pm.expect(product.product_id).to.be.a(\"string\")\r",
              "    pm.expect(product.name).to.be.a(\"string\")\r",
              "    pm.expect(product.model).to.be.a(\"string\")\r",
              "    pm.expect(product.option).to.be.an(\"array\")\r",
              "    pm.expect(product.quantity).to.be.a(\"string\")\r",
              "    pm.expect(product.stock).to.be.a(\"boolean\")\r",
              "    pm.expect(product.shipping).to.be.a(\"string\")\r",
              "    pm.expect(product.price).to.be.a(\"string\")\r",
              "    pm.expect(product.total).to.be.a(\"string\")\r",
              "    pm.expect(product.reward).to.be.a(\"number\")\r",
              "\r",
              "})\r",
              "responseData.totals.forEach(total =>\r",
              "{\r",
              "    pm.expect(total.title).to.be.a(\"string\")\r",
              "    pm.expect(total.text).to.be.a(\"string\")\r",
              "})\r",
              "\r",
              "})\r",
              "pm.test(\"Business validation\",()=>\r",
              "{\r",
              "    pm.expect(responseData.products).to.exist\r",
              "    pm.expect(responseData.products).to.not.be.empty\r",
              "    responseData.products.forEach(product =>\r",
              "{\r",
              "    pm.expect(product.cart_id).to.exist\r",
              "    pm.expect(Number(product.cart_id)).to.be.above(0)\r",
              "    pm.expect(product.product_id).to.exist\r",
              "    pm.expect(product.product_id).to.eql(pm.environment.get(\"product_id\"))\r",
              "    pm.expect(product.name).to.exist\r",
              "    pm.expect(product.name).to.not.be.empty\r",
              "    pm.expect(product.model).to.exist\r",
              "    pm.expect(product.model).to.not.be.empty\r",
              "    pm.expect(product.option).to.exist\r",
              "    pm.expect(product.quantity).to.exist\r",
              "    pm.expect(Number(product.quantity)).to.be.at.least(1)\r",
              "    pm.expect(product.stock).to.exist\r",
              "    pm.expect(product.stock).to.be.true\r",
              "    pm.expect(product.shipping).to.exist\r",
              "    pm.expect(Number(product.shipping)).to.be.above(0)\r",
              "    pm.expect(product.price).to.exist\r",
              "    const price=parseFloat(product.price.replace(\"$\",\"\"))\r",
              "    pm.expect(price).to.be.above(0)\r",
              "    pm.expect(product.total).to.exist\r",
              "    const total=parseFloat(product.total.replace(\"$\",\"\"))\r",
              "    pm.expect(total).to.be.above(0)\r",
              "    pm.expect(product.reward).to.exist\r",
              "    pm.expect(product.reward).to.be.at.least(0)\r",
              "\r",
              "    })\r",
              "    pm.expect(responseData.vouchers).to.exist\r",
              "    pm.expect(responseData.totals).to.exist\r",
              "    responseData.totals.forEach(total =>\r",
              "    {\r",
              "        pm.expect(total.title).to.exist\r",
              "        pm.expect(total.title).to.not.be.empty\r",
              "        pm.expect(total.text).to.exist\r",
              "        const text=parseFloat(total.text.replace(\"$\",\"\"))\r",
              "        pm.expect(text).to.be.above(0)\r",
              "    })\r",
              "    pm.environment.set(\"cartId\",responseData.products[0].cart_id)\r",
              "})"
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
