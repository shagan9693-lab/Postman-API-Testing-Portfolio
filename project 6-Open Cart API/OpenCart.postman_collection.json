              "pm.response.to.have.status(200)\r",
              "})\r",
              "pm.test(\"Response time validation\",()=>\r",
              "{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(4000)\r",
              "})\r",
              "pm.test(\"Structure validation\",()=>\r",
              "{\r",
              "    pm.expect(responseData).to.have.property(\"success\")\r",
              "    pm.expect(responseData).to.have.property(\"api_token\")\r",
              "})\r",
              "pm.test(\"Data type validation\",()=>\r",
              "{\r",
              "pm.expect(responseData.success).to.be.a(\"string\")\r",
              "pm.expect(responseData.api_token).to.be.a(\"string\")\r",
              "})\r",
              "pm.test(\"Business validation\",()=>\r",
              "{\r",
              "    pm.expect(responseData.success).to.exist\r",
              "    pm.expect(responseData.success).to.include(\"API session successfully started\")\r",
              "    pm.expect(responseData.api_token).to.exist\r",
              "    pm.expect(responseData.api_token).to.not.be.empty\r",
              "   if (responseData.api_token) {\r",
              "    pm.environment.set(\"Token\", responseData.api_token)\r",
              "}\r",
              "    \r",
              "})\r",
              ""
            ],
