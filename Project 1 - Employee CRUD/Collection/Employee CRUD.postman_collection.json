    {
      "name": "Get All Employees",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "const responseData=pm.response.json()\r",
              "pm.test(\"Response code validation\",()=>\r",
              "{\r",
              "    pm.response.to.have.status(200)\r",
              "})\r",
              "pm.test(\"Response time validation\",()=>\r",
              "{\r",
              "  pm.expect(pm.response.responseTime).to.be.below(10000);\r",
              "})\r",
              "pm.test(\"Data type and business Validation\",()=>\r",
              "{\r",
              "      pm.expect(responseData.status).to.be.eql(\"success\")\r",
              "    responseData.data.forEach(emp=>\r",
              "    {\r",
              "    pm.expect(emp.id).to.be.a('number')\r",
              "    pm.expect(emp.employee_name).to.be.a('string')\r",
              "    pm.expect(emp.employee_salary).to.be.a('number')\r",
              "    pm.expect(emp.employee_age).to.be.a('number')\r",
              "    pm.expect(emp.profile_image).to.be.a('string')\r",
              "    pm.expect(emp.id).to.not.be.null\r",
              "    pm.expect(emp.employee_name).to.not.be.null\r",
              "    pm.expect(Number(emp.employee_salary)).to.not.be.below(0)\r",
              "    pm.expect(Number(emp.employee_age)).to.not.be.below(18)\r",
              "}\r",
              "    )\r",
              "})\r",
              "\r",
              "pm.test(\"Employee count is not null\",()=>\r",
              "{\r",
              "    pm.expect(responseData.data.length).to.not.equal(0)\r",
              "})\r",
              ""
            ],
            "type": "text/javascript",
            "packages": {},
            "requests": {}
          }
        }
      ],
