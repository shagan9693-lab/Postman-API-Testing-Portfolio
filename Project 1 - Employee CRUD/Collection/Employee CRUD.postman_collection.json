    {
      "name": "Create new employee",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"response code validation\",()=>{\r",
              "    pm.expect(pm.response.code).to.be.eql(200)\r",
              "})\r",
              "pm.test(\"response time validation\",()=>{\r",
              "    pm.expect(pm.response.responseTime).to.be.below(2000)\r",
              "})\r",
              "const responseData=pm.response.json()\r",
              "const requestData=JSON.parse(pm.request.body.raw)\r",
              "\r",
              "\r",
              "pm.test(\"Response structure validation\",()=>{\r",
              "    pm.expect(responseData).to.have.property(\"status\")\r",
              "    pm.expect(responseData).to.have.property(\"message\")\r",
              "    pm.expect(responseData).to.have.property(\"data\")\r",
              "})\r",
              "pm.test(\"status validation\",()=>{\r",
              "    pm.expect(responseData.status).to.be.eql(\"success\")\r",
              "    })\r",
              "\r",
              "pm.test(\"message validation\",()=>{\r",
              "    pm.expect(responseData.message).to.be.eql(\"Successfully! Record has been added.\")\r",
              "})\r",
              "pm.test(\"data type validation\",()=>\r",
              "{\r",
              "    pm.expect(responseData.data.name).to.be.a('string')\r",
              "    pm.expect(responseData.data.salary).to.be.a('string')\r",
              "    pm.expect(responseData.data.age).to.be.a('string')\r",
              "    pm.expect(responseData.data.id).to.be.a('number')\r",
              "})\r",
              "pm.test(\"Business Validation\",()=>{\r",
              "    pm.expect(responseData.data.name).to.not.be.null\r",
              "    pm.expect(responseData.data.name).to.not.eql(\"\")\r",
              "    pm.expect(Number(responseData.data.salary)).to.be.above(0)\r",
              "    pm.expect(Number(responseData.data.age)).to.be.above(17)\r",
              "    pm.expect(responseData.data.id).to.be.exist\r",
              "\r",
              "})\r",
              "\r",
              "\r",
              "pm.test(\"Request and response validation\",()=>{\r",
              "    pm.expect(responseData.data.name).to.be.eql(requestData.name)\r",
              "    pm.expect(responseData.data.salary).to.be.eql(requestData.salary)\r",
              "    pm.expect(responseData.data.age).to.be.eql(requestData.age)\r",
              "  \r",
              "})\r",
              "\r",
              "pm.collectionVariables.set(\"empId\",responseData.data.id)\r",
              "\r",
              ""
            ],
